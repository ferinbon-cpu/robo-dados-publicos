  "document_claims": [
    {
      "id": "SAME_REVISION_RULE",
      "source_id": "CLARIFICATION2025",
      "locator": "PDF p.3, item d",
      "reviewed_paraphrase": "O IBGE condiciona a comparação temporal de estimativas municipais à mesma revisão das projeções; alteração de limite territorial também impede comparação direta."
    },
    {
      "id": "CENSUS_ESTIMATE_DISTINCTION",
      "source_id": "CLARIFICATION2025",
      "locator": "PDF pp.2-3, itens b-c",
      "reviewed_paraphrase": "Censo é apuração censitária; estimativas usam parâmetros dos censos anteriores. A diferença direta Censo 2022/estimativa 2025 não mede crescimento: há ajustes das projeções das UFs distribuídos aos municípios, tendências e possíveis mudanças territoriais."
    },
    {
      "id": "CENSUS_REFERENCE",
      "source_id": "CLARIFICATION2025",
      "locator": "PDF p.6, item j",
      "reviewed_paraphrase": "A referência censitária é 1º de agosto de 2022."
    },
    {
      "id": "PROJECTION_2013",
      "source_id": "HISTORICAL_METHODS2020",
      "locator": "PDF p.1, nota técnica 7 (não usar valores Brasil/UF como população municipal)",
      "reviewed_paraphrase": "As estimativas municipais de 2013 a 2017 foram calculadas com base na projeção de 2013 para Brasil e UFs."
    },
    {
      "id": "PROJECTION_2018_TO_2020",
      "source_id": "HISTORICAL_METHODS2020",
      "locator": "PDF p.1, nota técnica 8",
      "reviewed_paraphrase": "As estimativas municipais de 2018 a 2020 usaram a revisão 2018 das projeções."
    },
    {
      "id": "PROJECTION_2018_IN_2021",
      "source_id": "METHODOLOGY2021",
      "locator": "PDF pp.6-7 (impressas 4-5), Introdução e Metodologia",
      "reviewed_paraphrase": "Estimativas 2021 usam revisão 2018, com base censitária 2000/2010; não incorporam efeitos da pandemia de COVID-19."
    },
    {
      "id": "PROJECTION_2024_IN_2024",
      "source_id": "METHODOLOGY2024",
      "locator": "PDF pp.6,8-9 (impressas 4,6-7)",
      "reviewed_paraphrase": "Estimativas 2024 usam revisão 2024 e bases 2010/2022 ajustadas às projeções estaduais, referência em julho, harmonização do território 2010 ao 2022 e ajustes por porte populacional. Isso não constitui série municipal anual retrospectiva 2016-2023."
    },
    {
      "id": "PROJECTION_2024_IN_2025",
      "source_id": "METHODOLOGY2025",
      "locator": "PDF pp.6-11 (impressas 4-9)",
      "reviewed_paraphrase": "Estimativas 2025 usam revisão 2024 e bases 2010/2022 ajustadas; AiBi preserva a estrutura matemática, mas seus insumos e ajustes não equivalem aos das revisões anteriores."
    },
    {
      "id": "LIMEIRA_TERRITORIAL_UPDATE",
      "source_id": "METHODOLOGY2025",
      "locator": "PDF p.16 (impressa 14), Anexo 1, código 3526902",
      "reviewed_paraphrase": "Limeira consta entre municípios com alguma atualização territorial entre 01.05.2024 e 30.04.2025, com ou sem remanejamento populacional. A lista não quantifica seu efeito populacional nem permite assumir impacto zero."
    },
    {
      "id": "TCU_PUBLICATION_NOT_REFERENCE_2023",
      "source_id": "TCU2023_MUNICIPAL",
      "locator": "Aba Municípios, cabeçalho E4 e A3573:E3573; PDF homônimo pp.1 e 80",
      "reviewed_paraphrase": "A relação para publicação no DOU em 2023 explicita população do Censo 2022 e malha territorial 2023; Limeira tem 291869. Ano de publicação e malha não convertem referência populacional 2022 em 2023."
    },
    {
      "id": "API_PRODUCT_SCOPE",
      "source_id": "METADATA6579",
      "locator": "JSON id, pesquisa, nivelTerritorial, variaveis[id=9324], classificacoes; PERIODS6579",
      "reviewed_paraphrase": "Tabela 6579, Estimativas de População, variável 9324, população residente estimada, Pessoas, município N6, sem classificações; anos 2022 e 2023 não constam da disponibilidade adquirida."
    },
    {
      "id": "CENSUS_PRODUCT_SCOPE",
      "source_id": "METADATA4714",
      "locator": "JSON id, pesquisa, nivelTerritorial, variaveis[id=93], classificacoes; PERIODS4714",
      "reviewed_paraphrase": "Tabela 4714, Censo Demográfico, variável 93, população residente, Pessoas, N6, sem classificações; referência disponível 2022."
    }
  ],
