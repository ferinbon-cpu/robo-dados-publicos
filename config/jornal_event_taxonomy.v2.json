    "ATA_REGISTRO_PRECOS",
    "CONVENIO",
    "DECRETO",
    "PORTARIA",
    "LEI",
    "RESOLUCAO",
    "EDITAL",
    "AVISO_LICITACAO"
  ],
  "new_event_types": [
    "COMUNICADO",
    "PARECER",
    "INSTRUCAO_NORMATIVA",
    "DELIBERACAO",
    "RETIFICACAO",
    "TERMO_COLABORACAO",
    "TERMO_FOMENTO",
    "ACORDO_COOPERACAO",
    "ATO_CREDITO_ORCAMENTARIO",
    "AVISO_OPERACAO_ESCOLAR"
  ],
  "recognition_rules": {
    "COMUNICADO": "Explicit numbered heading only, optionally with a short institutional acronym/name.",
    "PARECER": "Explicit numbered heading only.",
    "INSTRUCAO_NORMATIVA": "Explicit numbered heading only.",
    "DELIBERACAO": "Explicit numbered heading only.",
    "RETIFICACAO": "Heading must explicitly name and number the target EDITAL, PORTARIA, DECRETO, LEI, RESOLUCAO or CONTRATO.",
    "TERMO_COLABORACAO": "Explicit TERMO DE COLABORACAO heading.",
    "TERMO_FOMENTO": "Explicit TERMO DE FOMENTO heading.",
    "ACORDO_COOPERACAO": "Explicit ACORDO DE COOPERACAO heading.",
    "ATO_CREDITO_ORCAMENTARIO": "Explicit CREDITO ADICIONAL, SUPLEMENTAR or ESPECIAL heading; ordinary budget prose does not create this event type.",
    "AVISO_OPERACAO_ESCOLAR": "Heading must explicitly state AVISO DE/SOBRE and a school-operation topic such as matricula, calendario escolar, atribuicao, transporte, alimentacao or funcionamento escolar."
  },
  "retification_rule": {
    "target_act_must_be_explicit": true,
    "nearby_act_identity_inheritance": false,
    "target_fields": ["target_act_type", "target_act_number"]
  },
  "school_operation_topics": [
    "ENROLLMENT",
    "SCHOOL_CALENDAR",
    "CLASS_ASSIGNMENT",
