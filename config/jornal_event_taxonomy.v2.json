    "SPECIAL_EDUCATION_AEE",
    "UNIT_OPEN_CLOSE_RELOCATION",
    "HOURS_SHIFT",
    "INFRASTRUCTURE_MAINTENANCE"
  ],
  "hard_guards": [
    "EVENT_TYPE_NE_POLICY_DOMAIN",
    "EVENT_TYPE_NE_EVIDENCE_LAYER",
    "EVENT_TYPE_NE_FINANCIAL_STAGE",
    "RETIFICATION_NE_TARGET_IDENTITY_UNLESS_EXPLICIT",
    "BUDGET_CREDIT_ACT_PROVES_AUTHORIZATION_OR_CHANGE_NOT_COMMITMENT_LIQUIDATION_PAYMENT",
    "SCHOOL_OPERATION_NOTICE_PROVES_PUBLICATION_NOT_IMPLEMENTATION_OR_RESULT",
