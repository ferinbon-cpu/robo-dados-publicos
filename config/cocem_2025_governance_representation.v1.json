      "source_page":2,
      "article":"Art. 5º, II",
      "rule":"Municipal-network teachers are elected by peers in school units; Annex II uses one representative for each ten classes from Berçário I through 5º ano and EJA."
    },
    {
      "id":"COCEM-RULE-003",
      "source_page":3,
      "article":"Art. 5º, IV",
      "rule":"Invited authorities and interested/invited civil-society members who are not delegates have no vote in plenary deliberations."
    },
    {
      "id":"COCEM-RULE-004",
      "source_page":3,
      "article":"Art. 6º",
      "rule":"SME provides point abono to its professionals participating as delegates upon proof of 100 percent attendance on both event days."
    },
    {
      "id":"COCEM-RULE-005",
      "source_pages":[3,4],
      "article":"Art. 7º",
      "rule":"Pre-conferences are in-person and non-deliberative; they study reference materials, elect/indicate delegates and prepare propositions within the defined period and submission rules."
    },
    {
      "id":"COCEM-RULE-006",
      "source_page":4,
      "article":"Art. 8º",
      "rule":"The conference is chaired by the Municipal Education Secretary, the CME President and designated representatives; it is in-person and deliberates proposals debated and approved by the plenary."
    },
    {
      "id":"COCEM-RULE-007",
      "source_pages":[5,6],
      "article":"Art. 11",
      "rule":"Proposals are presented by a school-unit/segment representative, debated after participant registration and approved when they obtain simple majority."
    },
    {
      "id":"COCEM-RULE-008",
      "source_page":6,
      "article":"Art. 12",
      "rule":"The organizing commission prepares the final minutes considering proposals, referrals and decisions approved by the plenary."
    },
    {
      "id":"COCEM-RULE-009",
      "source_page":6,
      "article":"Art. 14",
      "rule":"Organization and realization expenses are charged to budget appropriations assigned to the Municipal Education Secretariat; no monetary amount is stated in this article."
    }
